rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }
    function validItem(data) {
      return data.keys().hasOnly(['day','time','title','location','desc','rev']) &&
        data.keys().hasAll(['day','time','title','location','desc','rev']) &&
        data.day is int && data.day >= 0 && data.day < 7 &&
        data.time is string && data.time.size() <= 30 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
        data.location is string && data.location.size() <= 2048 &&
        data.desc is string && data.desc.size() <= 5000 &&
        data.rev is int && data.rev > 0;
    }
    function validBooking(data) {
      return data.keys().hasOnly(['day','title','status','url','note','rev']) &&
        data.keys().hasAll(['day','title','status','url','note','rev']) &&
        data.day is int && data.day >= 0 && data.day < 7 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
        data.status is string && data.status in ['待確認','尚未預約','已預約','不需預約'] &&
        data.url is string && data.url.size() <= 2048 &&
        data.note is string && data.note.size() <= 5000 &&
        data.rev is int && data.rev > 0;
    }
    match /members/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /trips/trip-1/meta/main {
      allow read: if member();
      allow create: if member() &&
        request.resource.data.keys().hasOnly(['dates','titles','notes']) &&
        request.resource.data.dates is list && request.resource.data.dates.size() == 7 &&
        request.resource.data.titles is list && request.resource.data.titles.size() == 7 &&
        request.resource.data.notes is list && request.resource.data.notes.size() == 7;
      allow update, delete: if false;
    }
    match /trips/trip-1/import/main {
      allow read: if member();
      allow create: if member() && request.resource.data.keys().hasOnly(['done']) && request.resource.data.done == true;
      allow update, delete: if false;
    }
    match /trips/trip-1/items/{id} {
      allow read: if member();
      allow create: if member() && validItem(request.resource.data) && request.resource.data.rev == 1;
      allow update: if member() && validItem(request.resource.data) && request.resource.data.rev == resource.data.rev + 1;
      allow delete: if member();
    }
    match /trips/trip-1/bookings/{id} {
      allow read: if member();
      allow create: if member() && validBooking(request.resource.data) && request.resource.data.rev == 1;
      allow update: if member() && validBooking(request.resource.data) && request.resource.data.rev == resource.data.rev + 1;
      allow delete: if member();
    }
  }
}
